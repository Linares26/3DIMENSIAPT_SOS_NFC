msgstr "Emergency NFC Keychains"

msgid "Tutor" 
msgstr "Tutor"

msgid "Mudar senha" 
msgstr "Change password"

msgid "Ativo" 
msgstr "Active"

msgid "Inativo" 
msgstr "Inactive"

msgid "Contacto SOS" 
msgstr "SOS Contact"

msgid "Alergias" 
msgstr "Allergies"

msgid "Ver Ficha NFC" 
msgstr "View NFC Profile"

msgid "Editar dados" 
msgstr "Edit data"

msgid "Não tem porta-chaves vinculados ainda" 
msgstr "No keychains linked yet"

msgid "Quando adquirir o seu porta-chaves físico 3DimensiaPT, escaneie o seu código ou vincule-o a partir do administrador para gerenciar a sua ficha médica." 
msgstr "When you purchase your physical 3DimensiaPT keychain, scan its code or link it from the administrator to manage your medical record."

msgid "Mude a sua senha." 
msgstr "Change your password."

msgid "Corrija os campos indicados." 
msgstr "Correct the indicated fields."

msgid "Atualizar senha" 
msgstr "Update password"

msgid "Voltar aos porta-chaves" 
msgstr "Back to keychains"

msgid "Senha redefinida" 
msgstr "Password reset"

msgid "A sua senha foi redefinida corretamente. Já pode fazer login." 
msgstr "Your password has been reset successfully. You can now log in."

