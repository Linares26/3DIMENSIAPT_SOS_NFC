msgstr "Access for parents and tutors"

msgid "Inicie sessão para editar a ficha de emergência do seu filho." 
msgstr "Sign in to edit your child's emergency record."

msgid "Usuário ou E-mail" 
msgstr "Username or E-mail"

msgid "Senha" 
msgstr "Password"

msgid "Esqueceu a sua senha?" 
msgstr "Forgot your password?"

msgid "Redirecionamento ativo: Após identificação, voltará à página que estava consultando." 
msgstr "Active redirection: After identification, you will return to the page you were viewing."

msgid "Não tem uma conta de tutor?" 
msgstr "Don't have a tutor account?"

msgid "Registe-se gratuitamente" 
msgstr "Register for free"

msgid "Os meus Porta-chaves NFC | 3DimensiaPT" 
msgstr "My NFC Keychains | 3DimensiaPT"

msgid "Painel Familiar" 
msgstr "Family Dashboard"

