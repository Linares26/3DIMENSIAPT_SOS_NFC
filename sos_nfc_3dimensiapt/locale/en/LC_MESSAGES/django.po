msgid "Modelo representativo de cada porta-chaves físico 3D com chip NFC integrado. \nUtiliza UUID v4 para gerar URLs não sequenciais e invulneráveis a escaneos por força bruta." 
msgstr "Representative model of each 3D physical keychain with integrated NFC chip. \nUses UUID v4 to generate non-sequential URLs that are invulnerable to brute-force scanning."

msgid "Não tem autorização para modificar este porta-chaves de emergência." 
msgstr "You do not have authorization to modify this emergency keychain."

