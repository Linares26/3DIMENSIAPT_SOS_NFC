msgstr "Email sent"

msgid "Link enviado" 
msgstr "Link sent"

msgid "Se o endereço coincidir com uma conta registrada, você receberá as instruções por e-mail." 
msgstr "If the address matches a registered account, you will receive instructions via email."

msgid "Voltar ao login" 
msgstr "Back to login"

msgid "Recuperar senha" 
msgstr "Recover password"

