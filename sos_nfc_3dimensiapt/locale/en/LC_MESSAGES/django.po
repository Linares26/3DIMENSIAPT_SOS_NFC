msgstr "Create your account to link and manage your 3D emergency keychains"

msgid "Por favor corrige os seguintes campos:" 
msgstr "Please correct the following fields:"

msgid "Nome" 
msgstr "Name"

msgid "Apelidos" 
msgstr "Last Name"

msgid "Nome de Usuário" 
msgstr "Username"

msgid "Repetir Senha" 
msgstr "Repeat Password"

msgid "Aceito os termos de custódia segura de dados médicos e contacto SOS." 
msgstr "I accept the terms of secure custody for medical data and SOS contact."

msgid "Criar minha Conta de Tutor" 
msgstr "Create my Guardian Account"

msgid "Já tens uma conta?" 
msgstr "Already have an account?"

msgid "Inicia sessão aqui" 
msgstr "Log in here"

msgid "Endereço de e-mail" 
msgstr "Email address"

msgid "Aceito os termos relativos à conservação de dados médicos de emergência ao abrigo do RGPD/COPPA" 
msgstr "I accept the terms regarding the preservation of emergency medical data under GDPR/COPPA"

msgid "Mínimo de 8 caracteres" 
msgstr "Minimum of 8 characters"

msgid "Já existe uma conta registada com este endereço de e-mail." 
msgstr "There is already an account registered with this email address."

msgid "Usuario o Email" 
msgstr "Username or Email"

msgid "jose_pai ou o teu email" 
msgstr "jose_parent or your email"

msgid "Palavra-passe" 
msgstr "Password"

msgid "Formulario para solicitar enlace de recuperación de contraseña por email" 
msgstr "Form to request password recovery link via email"

msgid "(para recuperação e alertas)" 
msgstr "(for recovery and alerts)"

msgid "Formulario cuando el padre hace clic en el enlace con token seguro" 
msgstr "Form when the parent clicks on the link with a secure token"

msgid "Nova palavra-passe segura" 
msgstr "New secure password"

msgid "Bem-vindo/a" 
msgstr "Welcome"

msgid "A sua conta de tutor foi criada com sucesso." 
msgstr "Your tutor account has been created successfully."

msgid "Por favor, reveja os erros no formulário." 
msgstr "Please review the errors in the form."

msgid "VISTA DE INICIO DE SESIÓN CON SOPORTE PARA '?next='. \nSi un padre escanea el llavero y pulsa 'Editar', la URL contiene '?next=/nfc/<uuid>/editar/'. \nAl autenticarse, vuelve inmediatamente a la ficha de su hijo." 
msgstr "LOGIN VIEW WITH '?next=' SUPPORT. \nif a parent scans the keychain and clicks 'Edit', the URL contains '?next=/nfc/<uuid>/edit/'. \nUpon authentication, they are immediately redirected back to their child's profile."

msgid "Sessão iniciada como" 
msgstr "Logged in as"

msgid "Usuario ou senha incorretos." 
msgstr "Incorrect username or password."

msgid "Encerra a sessão do pai e redireciona com mensagem de boas-vindas" 
msgstr "Ends the parent session and redirects with a welcome message"

msgid "Sessão encerrada de forma segura." 
msgstr "Session closed securely."

msgid "PAINEL PRIVADO DE PAIS: \nMostra a lista de todos os porta-chaves pertencentes ao pai logado, \nseus estados (ativo/inativo), total de leituras NFC e acessos diretos a edição." 
msgstr "PRIVATE PARENT DASHBOARD: \nShows the list of all keychains belonging to the logged-in parent, \ntheir statuses (active/inactive), total NFC scans, and direct access to editing."

msgid "Editar a Ficha de" 
msgstr "Edit Profile of"

msgid "Voltar para a vista pública" 
msgstr "Back to public view"

msgid "Editar Ficha de Emergência" 
msgstr "Edit Emergency Profile"

